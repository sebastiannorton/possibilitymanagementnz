{
  "name": "possibility-management-nz-website",
  "private": true,
  "version": "1.0.0",
  "description": "Possibility Management NZ website. Plain static HTML on Netlify, with Tina CMS editing the Expand the Box page.",
  "type": "module",
  "scripts": {
    "build": "node build/generate.mjs",
    "dev": "node build/generate.mjs && tinacms dev -c \"npx serve . -l 8080\"",
