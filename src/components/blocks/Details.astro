---
// Event details block — label/value rows (date, time, location).
import { tinaField } from '@tinacms/astro/tina-field';
interface Props { block: any }
const { block } = Astro.props;
const rows = block?.rows ?? [];
---
<div class="etb-details">
    {rows.map((row, i) => (
        <div class="etb-detail-row" data-tina-field={tinaField(block, 'rows', i)}>
            <span class="etb-detail-label">{row.label}</span>
            <span class="etb-detail-value">{row.value}</span>
        </div>
    ))}
</div>
